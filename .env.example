# ============================================================
# Instagram Monitor — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Supabase / PostgreSQL ---
# Get these from: https://supabase.com → Project Settings → Database
DB_HOST=db.your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password

# --- Telegram Bot ---
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Get your chat ID via @userinfobot or @RawDataBot
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- Monitoring Settings ---
# Interval between check cycles in seconds (default: 300 = 5 minutes)
CHECK_INTERVAL_SECONDS=300
# Delay between individual username checks in seconds (default: 10)
CHECK_DELAY_SECONDS=10
# Maximum concurrent checks (default: 3)
MAX_CONCURRENT_CHECKS=3

# --- Application ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log directory (relative to project root)
LOG_DIR=logs
# Environment: development, staging, production
ENVIRONMENT=development
